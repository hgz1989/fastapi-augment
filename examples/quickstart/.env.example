# 复制为 .env 使用；环境变量优先级高于 .env 文件

# ── 全局配置（QUICKSTART_ 前缀）──
QUICKSTART_DEBUG=false
QUICKSTART_LOGS_DIR=./logs
QUICKSTART_LOGS_LEVEL=INFO
QUICKSTART_LOGS_ENABLE_CONSOLE=true

# ── 数据库（默认 SQLite，文件 data/quickstart.db）──
QUICKSTART_DATABASE__ENGINE=sqlite
QUICKSTART_DATABASE__NAME=./data/quickstart.db

# ── 项目元信息（QUICKSTART_PROJECT_ 前缀）──
QUICKSTART_PROJECT_DEBUG=false

# ── Uvicorn 运行参数（QUICKSTART_UVICORN_ 前缀）──
QUICKSTART_UVICORN_HOST=0.0.0.0
QUICKSTART_UVICORN_PORT=8000
QUICKSTART_UVICORN_WORKERS=2
QUICKSTART_UVICORN_ACCESS_LOG=true
QUICKSTART_UVICORN_ASGI_APP_REF=apps.api:app
