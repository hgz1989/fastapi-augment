# fastapi-augment Demo 配置模板
# 复制为同目录 .env 后生效；环境变量优先级高于本文件（如 set DEMO_DOCS_ACCOUNTS=demo:secret123）
#
# 应用信息
DEMO_TITLE=fastapi-augment Demo
DEMO_SUMMARY=单文件基础应用示例
DEMO_VERSION=0.1.0

# Docs 登录保护：账号列表，格式 user1:pass1,user2:pass2（多账号）
# 配置后 /docs /redoc /openapi.json 需登录（未登录跳转各自 /login 登录页）
DEMO_DOCS_ACCOUNTS=demo:secret123,ops:secret456

# Docs 登录 Cookie 签名密钥（HMAC-SHA256，生产环境务必替换为随机长字符串）
# 缺省时 create_app 自动随机生成，进程重启后已发 Cookie 全部失效
DEMO_DOCS_SECRET=change-me-to-a-random-long-secret

# Docs 页面 logo（可选）：URL / data URI / 本地路径均可；
# 不配置时尝试包内 assets/logo.png，两者均无则不显示 logo
# DEMO_DOCS_LOGO=https://example.com/logo.png
